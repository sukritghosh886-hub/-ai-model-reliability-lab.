
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#111827">
  <title>AI Model Reliability Lab</title>
  <style>
    :root {
      color-scheme: dark;
      --bg: #0b1120;
      --panel: #151e30;
      --border: #29364b;
      --text: #edf2f7;
      --muted: #a7b4c8;
      --accent: #78a9ff;
      --good: #86efac;
      --bad: #fca5a5;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font: 16px/1.6 system-ui, -apple-system, sans-serif;
    }
    header, main, footer {
      width: min(100% - 28px, 900px);
      margin: auto;
    }
    header { padding: 30px 0 18px; }
    h1 { font-size: clamp(27px, 6vw, 42px); line-height: 1.15; margin: 0 0 12px; }
    h2 { font-size: 19px; margin-top: 0; }
    p { color: var(--muted); }
    .tag { color: var(--accent); font-weight: 700; letter-spacing: .08em; font-size: 12px; }
    .panel {
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 20px;
      margin: 14px 0;
    }
    .metrics {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(135px, 1fr));
      gap: 10px;
    }
    .metric {
      padding: 15px;
      border: 1px solid var(--border);
      border-radius: 12px;
      min-width: 0;
    }
    .metric span { display: block; color: var(--muted); font-size: 13px; }
    .metric strong { display: block; font-size: 25px; overflow-wrap: anywhere; }
    label { display: block; font-weight: 650; margin: 12px 0 8px; }
    input[type="file"] {
      display: block;
      width: 100%;
      padding: 12px;
      border: 1px dashed #52627b;
      border-radius: 10px;
      background: #0f1728;
      color: var(--text);
    }
    button, .download {
      display: inline-block;
      padding: 12px 16px;
      margin: 10px 8px 0 0;
      border: 0;
      border-radius: 10px;
      background: var(--accent);
      color: #081226;
      font-weight: 750;
      text-decoration: none;
      cursor: pointer;
    }
    button.secondary { background: #34445e; color: var(--text); }
    button:focus-visible, a:focus-visible, input:focus-visible {
      outline: 3px solid #fbbf24;
      outline-offset: 3px;
    }
    .table-wrap { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; margin-top: 8px; }
    th, td { padding: 10px; border: 1px solid var(--border); text-align: center; }
    th { color: var(--accent); }
    .status { min-height: 24px; overflow-wrap: anywhere; }
    .good { color: var(--good); }
    .bad { color: var(--bad); }
    code { color: #c4b5fd; overflow-wrap: anywhere; }
    footer { padding: 8px 0 30px; font-size: 13px; }
    @media (max-width: 480px) {
      .panel { padding: 15px; }
      .metric strong { font-size: 22px; }
      button, .download { width: 100%; text-align: center; margin-right: 0; }
    }
  </style>
</head>
<body>
  <header>
    <div class="tag">PORTFOLIO PROJECT · VERSION 1.0</div>
    <h1>AI Model Reliability Lab</h1>
    <p>A lightweight tool for evaluating binary classification predictions using accuracy, precision, recall, F1 score, and a confusion matrix.</p>
  </header>

  <main>
    <section class="panel">
      <h2>1. Evaluate your predictions</h2>
      <p>Upload a CSV containing <code>y_true</code> and <code>y_pred</code> columns. Both columns must contain only 0 and 1. An optional <code>latency_ms</code> column can report measured prediction latency.</p>
      <label for="csvFile">Choose CSV file (maximum 2 MB)</label>
      <input id="csvFile" type="file" accept=".csv,text/csv">
      <button id="evaluateBtn" type="button">Evaluate CSV</button>
      <button id="sampleBtn" class="secondary" type="button">Load sample data</button>
      <a id="downloadSample" class="download" href="#" download="sample_predictions.csv">Download sample CSV</a>
      <p id="status" class="status" role="status" aria-live="polite">Choose a file or load the sample to begin.</p>
    </section>

    <section class="panel">
      <h2>2. Evaluation metrics</h2>
      <div class="metrics">
        <div class="metric"><span>Accuracy</span><strong id="accuracy">—</strong></div>
        <div class="metric"><span>Precision (class 1)</span><strong id="precision">—</strong></div>
        <div class="metric"><span>Recall (class 1)</span><strong id="recall">—</strong></div>
        <div class="metric"><span>F1 score (class 1)</span><strong id="f1">—</strong></div>
        <div class="metric"><span>Evaluated rows</span><strong id="rows">—</strong></div>
        <div class="metric"><span>Mean supplied latency</span><strong id="latency">—</strong></div>
      </div>
      <p>Scores are calculated from the uploaded labels. If a precision or recall denominator is zero, that metric is displayed as 0%.</p>
    </section>

    <section class="panel">
      <h2>3. Confusion matrix</h2>
      <p>Rows represent actual labels; columns represent predicted labels.</p>
      <div class="table-wrap">
        <table aria-label="Confusion matrix">
          <thead>
            <tr><th>Actual \ Predicted</th><th>Predicted 0</th><th>Predicted 1</th></tr>
          </thead>
          <tbody>
            <tr><th>Actual 0</th><td id="tn">—</td><td id="fp">—</td></tr>
            <tr><th>Actual 1</th><td id="fn">—</td><td id="tp">—</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="panel">
      <h2>4. Interpretation and limitations</h2>
      <p id="interpretation">Run an evaluation to see a brief interpretation of the results.</p>
      <p><strong>Important:</strong> This is an educational evaluation utility, not a certification of model safety or reliability. It evaluates the labels you supply; it does not independently verify them, train a model, or assess fairness, robustness, privacy, or real-world performance.</p>
    </section>
  </main>

  <footer>
    <p>Privacy: CSV processing happens in this browser page. This app does not send your CSV to an application server. Only use data you are authorized to process.</p>
    <p>Created for the AI Model Reliability Lab portfolio project.</p>
  </footer>

  <script>
    "use strict";

    const sampleCSV = [
      "y_true,y_pred,latency_ms",
      "1,1,12",
      "1,0,15",
      "0,0,10",
      "0,0,11",
      "1,1,13",
      "0,1,17"
    ].join("\n");

    const byId = (id) => document.getElementById(id);

    function setStatus(message, isError = false) {
      const el = byId("status");
      el.textContent = message;
      el.className = "status " + (isError ? "bad" : "good");
    }

    function formatPercent(value) {
      return (value * 100).toFixed(2) + "%";
    }

    function resetResults() {
      ["accuracy", "precision", "recall", "f1", "rows", "latency",
       "tn", "fp", "fn", "tp"].forEach(id => byId(id).textContent = "—");
      byId("interpretation").textContent =
        "Run an evaluation to see a brief interpretation of the results.";
    }

    function parseCSV(text) {
      // Supports simple comma-separated files without quoted commas or multiline fields.
      const lines = text.replace(/^\uFEFF/, "").trim().split(/\r?\n/);
      if (lines.length < 2) throw new Error("The CSV must include a header and at least one data row.");

      const headers = lines[0].split(",").map(x => x.trim().toLowerCase());
      const trueIndex = headers.indexOf("y_true");
      const predIndex = headers.indexOf("y_pred");
      const latencyIndex = headers.indexOf("latency_ms");

      if (trueIndex < 0 || predIndex < 0) {
        throw new Error("Required headers are y_true and y_pred. Please check the first row.");
      }

      const records = [];
      for (let i = 1; i < lines.length; i++) {
        if (!lines[i].trim()) continue;
        const cells = lines[i].split(",").map(x => x.trim());
        if (cells.length !== headers.length) {
          throw new Error("Row " + (i + 1) + " has a different number of columns than the header.");
        }

        const actual = cells[trueIndex];
        const predicted = cells[predIndex];
        if (!["0", "1"].includes(actual) || !["0", "1"].includes(predicted)) {
          throw new Error("Row " + (i + 1) + ": y_true and y_pred must be 0 or 1.");
        }

        let latency = null;
        if (latencyIndex >= 0 && cells[latencyIndex] !== "") {
          latency = Number(cells[latencyIndex]);
          if (!Number.isFinite(latency) || latency < 0) {
            throw new Error("Row " + (i + 1) + ": latency_ms must be a non-negative number.");
          }
        }

        records.push({
          actual: Number(actual),
          predicted: Number(predicted),
          latency
        });
      }

      if (records.length === 0) throw new Error("No valid data rows were found.");
      return records;
    }

    function evaluate(records) {
      let tn = 0, fp = 0, fn = 0, tp = 0;
      const latencies = [];

      records.forEach(row => {
        if (row.actual === 0 && row.predicted === 0) tn++;
        else if (row.actual === 0 && row.predicted === 1) fp++;
        else if (row.actual === 1 && row.predicted === 0) fn++;
        else tp++;

        if (row.latency !== null) latencies.push(row.latency);
      });

      const total = records.length;
      const accuracy = (tp + tn) / total;
      const precision = tp + fp === 0 ? 0 : tp / (tp + fp);
      const recall = tp + fn === 0 ? 0 : tp / (tp + fn);
      const f1 = precision + recall === 0
        ? 0
        : (2 * precision * recall) / (precision + recall);

      byId("accuracy").textContent = formatPercent(accuracy);
      byId("precision").textContent = formatPercent(precision);
      byId("recall").textContent = formatPercent(recall);
      byId("f1").textContent = formatPercent(f1);
      byId("rows").textContent = String(total);
      byId("latency").textContent = latencies.length
        ? (latencies.reduce((sum, value) => sum + value, 0) / latencies.length).toFixed(2) + " ms"
        : "Not provided";

      byId("tn").textContent = tn;
      byId("fp").textContent = fp;
      byId("fn").textContent = fn;
      byId("tp").textContent = tp;

      let summary = "Evaluated " + total + " rows. ";
      summary += fp + " false positive(s) and " + fn + " false negative(s) were found. ";
      if (latencies.length) {
        summary += "Mean latency is based only on the " + latencies.length +
          " rows with supplied latency values. ";
      } else {
        summary += "No latency measurements were supplied. ";
      }
      summary += "Review the confusion matrix in the context of your application.";
      byId("interpretation").textContent = summary;
      setStatus("Evaluation complete. Results were calculated in your browser.");
    }

    async function evaluateFile(file) {
      resetResults();
      if (!file) {
        setStatus("Please choose a CSV file first.", true);
        return;
      }
      if (file.size > 2 * 1024 * 1024) {
        setStatus("This file is larger than 2 MB. Please choose a smaller CSV.", true);
        return;
      }
      try {
        const text = await file.text();
        evaluate(parseCSV(text));
      } catch (error) {
        resetResults();
        setStatus(error.message || "Could not read this CSV file.", true);
      }
    }

    byId("evaluateBtn").addEventListener("click", () => {
      evaluateFile(byId("csvFile").files[0]);
    });

    byId("sampleBtn").addEventListener("click", () => {
      byId("csvFile").value = "";
      try {
        evaluate(parseCSV(sampleCSV));
      } catch (error) {
        setStatus(error.message, true);
      }
    });

    byId("downloadSample").href =
      URL.createObjectURL(new Blob([sampleCSV], { type: "text/csv;charset=utf-8" }));

    resetResults();
  </script>
</body>
</html>
